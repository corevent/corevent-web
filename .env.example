# Copie para `.env` (ignorado pelo Git). Ele é usado no `pnpm dev`.
# Para o build de produção (`pnpm build` / CI), os valores vêm de `.env.production`.

# Endereço que o navegador usa para chamar a API.
# Em dev, mantenha "/api": a chamada passa pelo proxy do Vite (sem problemas de CORS).
VITE_API_URL=/api

# Só em dev: para onde o proxy do Vite encaminha "/api" (API local ou de staging).
VITE_API_PROXY_TARGET=http://localhost:3000

# Links de download dos apps mobile. Vazio = o site mostra "disponível em breve".
VITE_PARTICIPANT_APP_URL=
VITE_ORGANIZER_APP_URL=
