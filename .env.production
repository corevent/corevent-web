# Usado no `pnpm build` (local e no CI do GitHub). Versionado: só valores públicos —
# tudo que começa com VITE_ fica visível no site publicado. Nunca coloque segredos aqui.

# URL completa da API (no Firebase não existe proxy). A API precisa liberar o site em CORS_ORIGINS.
VITE_API_URL=https://corevent-staging-api-666040325433.us-central1.run.app/api

# Links de download dos apps mobile (participantes e colaboradores). Vazio = "disponível em breve".
VITE_PARTICIPANT_APP_URL=https://github.com/corevent/CoreventMobileApp/releases
VITE_ORGANIZER_APP_URL=https://www.youtube.com/watch?v=paC0L7sl164&pp=0gcJCTIMAYcqIYzv
