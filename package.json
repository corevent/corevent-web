{
  "name": "corevent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:api",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "vitest run",
    "test:api": "jest --selectProjects api",
    "test:watch": "vitest",
    "test:coverage": "jest --selectProjects unit --coverage && vitest run --coverage",
    "test:e2e": "start-server-and-test \"vite --mode e2e --port 4174 --strictPort\" http://localhost:4174 \"cypress run --browser chrome\"",
    "test:e2e:open": "start-server-and-test \"vite --mode e2e --port 4174 --strictPort\" http://localhost:4174 \"cypress open --e2e\"",
    "test:all": "pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.5.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-jest": "^30.5.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-plugin-transform-vite-meta-env": "^1.0.3",
    "cypress": "^16.3.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "oxlint": "^1.81.0",
    "start-server-and-test": "^3.0.13",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
